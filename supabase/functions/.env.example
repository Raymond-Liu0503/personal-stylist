APP_ENV=local
# `supabase functions serve` injects these three values automatically.
# Set them manually only when running the function outside the Supabase CLI.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace-with-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
AI_PROVIDER=mock
MOCK_SCENARIO=success
ANALYSIS_ENABLED=true
OUTFIT_ENABLED=true
REPORT_SIGNING_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_CONFIG_APPROVED=false
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Exact reviewed Vertex routes only; no AI Studio or fallback.
OPENROUTER_PROVIDERS=google-vertex/global
OPENROUTER_API_KEY=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
